# Secrets and local configuration — never commit these.
.env
.env.*
!.env.template

# Local databases (contain user accounts and password hashes)
*.db
*.sqlite
*.sqlite3

# Python
.venv/
__pycache__/
*.py[cod]

# Node / frontend build output
node_modules/
dist/
dist-ssr/
*.local

# Vendored runtimes — large and machine-specific
tmp-runtimes/

# Logs
logs/
*.log
npm-debug.log*

# OS / editor cruft
.DS_Store
.idea/
*.swp
