# --- Required ---

# Google Gemini API key. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Secret used to sign JWT access tokens. There is NO default in the code on
# purpose: a hardcoded fallback lets anyone who can read the source forge a
# token for any account. Generate your own:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=generate_a_random_64_character_hex_string

# --- Optional ---

# Comma-separated browser origins allowed to call this API.
# Defaults to the local Vite dev server if unset.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seed a demo account at startup. Off by default: an always-present account with
# a known password is a backdoor. Both variables are required to enable it.
# ENABLE_DEMO_USER=true
# DEMO_USER_EMAIL=student@example.com
# DEMO_USER_PASSWORD=choose_a_strong_password_here
